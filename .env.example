# Postgres connection string. In production this must be an externally
# reachable URL (Render's "External Database URL", not the internal one) —
# the app connects over plain TCP via `pg`, not through Render's private network.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Resend API key, used to email team.nivarro@gmail.com when a /connect
# survey is completed. Get one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Plain-text password for the /connect/dashboard. Never commit the real
# value — this file only documents that the var exists.
DASHBOARD_PASSWORD=change-me
